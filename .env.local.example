# Copy this file to .env.local (which is gitignored) and fill in values from your
# Firebase service account key JSON (Firebase Console -> Project Settings -> Service
# accounts -> Generate new private key).
#
# Never paste real values into this .example file, and avoid pasting the raw JSON
# into a chat/AI tool if you can help it -- paste the individual field values instead,
# or edit .env.local directly.

FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Paste the private_key value here exactly as it appears in the JSON, including the
# -----BEGIN PRIVATE KEY-----...-----END PRIVATE KEY----- wrapper and \n sequences.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Firebase Web App config for browser-based Authentication. In Firebase Console,
# open Project Settings -> General -> Your apps and register/select a Web app.
# Email/Password must also be enabled under Authentication -> Sign-in method.
NEXT_PUBLIC_FIREBASE_API_KEY=your-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-web-app-id

# Gmail SMTP for sending password-reset emails ourselves (bypasses the Firebase
# Console's built-in email templates). GMAIL_SMTP_APP_PASSWORD must be a 16-character
# Google Account App Password, not your normal Gmail password -- generate one at
# https://myaccount.google.com/apppasswords (requires 2-Step Verification enabled).
GMAIL_SMTP_USER=your-address@gmail.com
GMAIL_SMTP_APP_PASSWORD=your-16-char-app-password

# Optional: override for the logo shown in the password-reset email header. Leave unset
# and it defaults to the site's own public/logo.png (already deployed, no extra setup).
# Only set this if you want a different image hosted elsewhere -- note some hosts (e.g.
# Firebase Storage's default Cache-Control: private) can be unreliable through email
# image proxies like Gmail's, so prefer a plain public static URL.
MAIL_LOGO_URL=

# Boy/girl character portrait images shown on /inventory, hosted on Firebase Storage.
# Generate these by running: npm run seed:portraits (uploads the same art Unity's
# Character Panel uses, from the sibling Unity project's Assets/Resources/Sprite/) --
# it prints the two URLs to paste here.
CHARACTER_PORTRAIT_BOY_URL=
CHARACTER_PORTRAIT_GIRL_URL=

# Xsolla real-money Gold top-up (see CLAUDE.md's Xsolla checklist). Leave all four unset
# and the top-up page just shows "Pending Xsolla approval" instead of failing -- these are
# only needed once the Xsolla project is actually approved/activated.
# XSOLLA_PROJECT_ID / XSOLLA_MERCHANT_ID / XSOLLA_API_KEY come from the Xsolla Publisher
# Account (publisher.xsolla.com) once the project exists.
XSOLLA_PROJECT_ID=
XSOLLA_MERCHANT_ID=
XSOLLA_API_KEY=
# Set under Xsolla Publisher Account -> Settings -> Webhooks -> Secret key. Used to verify
# incoming webhook requests are actually from Xsolla (see src/lib/xsollaServer.ts).
XSOLLA_WEBHOOK_SECRET=
# Set to "false" once ready to go live -- defaults to sandbox (safe) if unset or anything
# other than the literal string "false".
XSOLLA_SANDBOX=true

# Cloudflare R2 storage for the APK uploaded from Admin -> Game Flags. Requires an
# R2-specific Access Key ID/Secret pair -- NOT the Cloudflare API token used by wrangler.
# Generate one from the Cloudflare dashboard: R2 -> Manage R2 API Tokens -> Create API
# Token (Object Read & Write permission). It shows the Access Key ID, Secret Access Key,
# and endpoint (https://<account-id>.r2.cloudflarestorage.com) once -- copy immediately.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public base URL the bucket serves downloads from -- either the bucket's r2.dev "Public
# Development URL" (Bucket -> Settings) or a custom domain connected under Bucket ->
# Settings -> Custom Domains. No trailing slash.
R2_PUBLIC_BASE_URL=
