# Copy this file to .env.local (which is gitignored) and fill in values from your
# Firebase service account key JSON (Firebase Console -> Project Settings -> Service
# accounts -> Generate new private key).
#
# Never paste real values into this .example file, and avoid pasting the raw JSON
# into a chat/AI tool if you can help it -- paste the individual field values instead,
# or edit .env.local directly.

FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Paste the private_key value here exactly as it appears in the JSON, including the
# -----BEGIN PRIVATE KEY-----...-----END PRIVATE KEY----- wrapper and \n sequences.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Firebase Web App config for browser-based Authentication. In Firebase Console,
# open Project Settings -> General -> Your apps and register/select a Web app.
# Email/Password must also be enabled under Authentication -> Sign-in method.
NEXT_PUBLIC_FIREBASE_API_KEY=your-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-web-app-id
